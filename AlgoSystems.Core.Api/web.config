<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\AlgoSystems.Core.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <!-- Only add mimeMap if not already defined (i.e., check if it's not a duplicate) -->
      <staticContent>
        <!-- Add mimeMap for .txt, but IIS already includes this globally, so we don't need to duplicate it -->
        <!-- <mimeMap fileExtension=".txt" mimeType="text/plain" /> -->
      </staticContent>
      <security>
        <requestFiltering>
          <!-- Allow .txt file extension in the request filtering settings -->
          <fileExtensions>
            <add fileExtension=".txt" allowed="true" />
          </fileExtensions>
          <!-- Remove .well-known from hidden segments -->
          <hiddenSegments>
            <remove segment=".well-known" />
          </hiddenSegments>
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
