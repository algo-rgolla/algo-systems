 @if (@Model.ScanType?.ToString() == Scans.LongEMATrendStarters)
{
    <div class="alert alert-success col-md-6">
        <strong>
            <i class="ace-icon fa fa-check"></i>
            EMA Trend Starters
        </strong>
        <ul>
            <li> EMA 9 > EMA 21 > 63 for the first time</li>
        </ul>
        <br/>
