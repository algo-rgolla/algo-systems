@using AlgoSystems.Common;
@model BusinessObjects.ProductsViewModel
@{
    ViewBag.Title = "ASX200Charts";
}
<h1>Scan - @Model.PageHeader</h1>
<div class="alert alert-success col-md-6">
    <strong>
        <i class="ace-icon fa fa-check"></i>
        Global Rules
    </strong>
    <ul>
        <li> Stock Price > 1$</li>        
        <li> Today stock turnover > 300k</li>        
        <li> Change > 0 and < 5%</li>
        <li> MarketCap > 100 mil</li>
        <li> Stocks trading today</li>
    </ul>    
</div>
@if (@Model.ScanType?.ToString() == Scans.LongMACDCrossover)
{
    <div class="alert alert-success col-md-6">
        <strong>
            <i class="ace-icon fa fa-check"></i>
            MACD Scan Rules
        </strong>
        <ul>
            <li> MACD &lt; 0</li>
            <li> MACD line crosses Signal line</li>
            <li> Stock Price > EMA 200</li>            
        </ul>
        <br/>
    </div>
}
